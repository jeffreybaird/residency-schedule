<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="URMC OBGYN">
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));

        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();
    </script>
  </head>
  <body>
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-50">
      <div class="px-4 sm:px-6 py-3 flex items-center justify-between">
        <a
          href="/"
          class="flex items-center gap-2 text-base font-semibold text-gray-800 hover:text-blue-600 transition-colors shrink-0"
        >
          <img src="/favicon.svg" alt="" class="w-6 h-6" /> URMC OBGYN
        </a>

        <%!-- Desktop nav --%>
        <div class="hidden sm:flex items-center gap-1">
          <a
            href="/"
            class="px-3 py-1.5 rounded-md text-sm text-gray-600 hover:bg-gray-100 hover:text-gray-900 transition-colors"
          >
            Schedule
          </a>
          <a
            href="/calendar"
            class="px-3 py-1.5 rounded-md text-sm text-gray-600 hover:bg-gray-100 hover:text-gray-900 transition-colors"
          >
            Calendar
          </a>
          <a
            href="/compare"
            class="px-3 py-1.5 rounded-md text-sm text-gray-600 hover:bg-gray-100 hover:text-gray-900 transition-colors"
          >
            Compare
          </a>
          <%= if my_id = get_session(@conn, :resident_id) do %>
            <%= if @conn.request_path == "/residents/#{my_id}" do %>
              <span class="px-3 py-1.5 rounded-md text-sm text-green-700 bg-green-50 font-medium">
                Home
              </span>
            <% else %>
              <a
                href={"/residents/#{my_id}"}
                class="px-3 py-1.5 rounded-md text-sm text-green-700 hover:bg-green-50 transition-colors"
              >
                Home
              </a>
            <% end %>
          <% end %>
          <%= if get_session(@conn, :admin) do %>
            <a
              href="/admin"
              class="px-3 py-1.5 rounded-md text-sm text-amber-600 hover:bg-amber-50 hover:text-amber-800 transition-colors"
            >
              Admin
            </a>
            <a
              href="/admin/build"
              class="px-3 py-1.5 rounded-md text-sm text-amber-600 hover:bg-amber-50 hover:text-amber-800 transition-colors"
            >
              Build
            </a>
            <a
              href="/admin/edit"
              class="px-3 py-1.5 rounded-md text-sm text-amber-600 hover:bg-amber-50 hover:text-amber-800 transition-colors"
            >
              Edit
            </a>
          <% end %>
          <span class="w-px h-4 bg-gray-200 mx-1"></span>
          <form action="/logout" method="post">
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <button
              type="submit"
              class="px-3 py-1.5 rounded-md text-sm text-gray-500 hover:bg-gray-100 hover:text-gray-900 transition-colors"
            >
              Sign out
            </button>
          </form>
        </div>

        <%!-- Mobile hamburger --%>
        <details class="sm:hidden relative">
          <summary class="list-none cursor-pointer p-2 rounded-md hover:bg-gray-100 transition-colors">
            <svg
              class="w-5 h-5 text-gray-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"
              />
            </svg>
          </summary>
          <div class="absolute right-0 top-full mt-1 w-44 bg-white border border-gray-200 rounded-xl shadow-lg py-1 z-50">
            <a href="/" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
              Schedule
            </a>
            <a href="/calendar" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
              Calendar
            </a>
            <a href="/compare" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
              Compare
            </a>
            <%= if my_id = get_session(@conn, :resident_id) do %>
              <%= if @conn.request_path == "/residents/#{my_id}" do %>
                <span class="block px-4 py-2 text-sm text-green-700 font-medium bg-green-50">
                  Home
                </span>
              <% else %>
                <a
                  href={"/residents/#{my_id}"}
                  class="block px-4 py-2 text-sm text-green-700 hover:bg-green-50"
                >
                  Home
                </a>
              <% end %>
            <% end %>
            <%= if get_session(@conn, :admin) do %>
              <a href="/admin" class="block px-4 py-2 text-sm text-amber-600 hover:bg-amber-50">
                Admin
              </a>
              <a
                href="/admin/build"
                class="block px-4 py-2 text-sm text-amber-600 hover:bg-amber-50"
              >
                Build
              </a>
              <a
                href="/admin/edit"
                class="block px-4 py-2 text-sm text-amber-600 hover:bg-amber-50"
              >
                Edit
              </a>
            <% end %>
            <div class="border-t border-gray-100 mt-1 pt-1">
              <form action="/logout" method="post">
                <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                <button
                  type="submit"
                  class="block w-full text-left px-4 py-2 text-sm text-gray-500 hover:bg-gray-50"
                >
                  Sign out
                </button>
              </form>
            </div>
          </div>
        </details>
      </div>
    </nav>
    {@inner_content}
  </body>
</html>
