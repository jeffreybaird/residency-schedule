<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="brand-name" content={ResidencySchedule.brand_name()} />
    <meta name="demo-mode" content={to_string(ResidencySchedule.demo_mode?())} />
    <.live_title default={ResidencySchedule.brand_name()}>
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));

        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();
    </script>
  </head>
  <body>
    <.demo_banner />
    <%!--
      Live navigation replaces only the LiveView below the nav, so nothing in
      this nav re-renders between pages. Anything here that depends on the
      current page (the home link's aria-current, the open mobile menu) is
      kept in step by app.js on phx:navigate.
    --%>
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-50">
      <div class="px-4 sm:px-6 py-3 flex items-center justify-between">
        <.link
          navigate="/"
          class="flex items-center gap-2 text-base font-semibold text-gray-800 hover:text-blue-600 transition-colors shrink-0"
        >
          <img src="/favicon.svg" alt="" class="w-6 h-6" />{ResidencySchedule.brand_name()}
        </.link>

        <%!-- Desktop nav --%>
        <div id="tour-nav" class="hidden sm:flex items-center gap-1">
          <.link
            navigate="/"
            class="px-3 py-1.5 rounded-md text-sm text-gray-600 hover:bg-gray-100 hover:text-gray-900 transition-colors"
          >
            Calendar
          </.link>
          <.link
            id="tour-nav-schedule"
            navigate="/schedule"
            class="px-3 py-1.5 rounded-md text-sm text-gray-600 hover:bg-gray-100 hover:text-gray-900 transition-colors"
          >
            Schedule
          </.link>
          <.link
            id="tour-nav-compare"
            navigate="/compare"
            class="px-3 py-1.5 rounded-md text-sm text-gray-600 hover:bg-gray-100 hover:text-gray-900 transition-colors"
          >
            Compare
          </.link>
          <%= if user = @conn.assigns[:current_user] do %>
            <%= if my_page_path = nav_home_path(user) do %>
              <.link
                navigate={my_page_path}
                data-nav-home
                aria-current={if @conn.request_path == my_page_path, do: "page"}
                class="px-3 py-1.5 rounded-md text-sm text-green-700 hover:bg-green-50 transition-colors aria-[current=page]:bg-green-50 aria-[current=page]:font-medium"
              >
                {nav_home_label(user)}
              </.link>
            <% end %>
          <% end %>
          <%= if ResidencySchedule.Accounts.User.admin?(@conn.assigns[:current_user]) do %>
            <.link
              navigate="/admin"
              class="px-3 py-1.5 rounded-md text-sm text-amber-600 hover:bg-amber-50 hover:text-amber-800 transition-colors"
            >
              Admin
            </.link>
            <.link
              navigate="/admin/build"
              class="px-3 py-1.5 rounded-md text-sm text-amber-600 hover:bg-amber-50 hover:text-amber-800 transition-colors"
            >
              Build
            </.link>
            <.link
              navigate="/admin/edit"
              class="px-3 py-1.5 rounded-md text-sm text-amber-600 hover:bg-amber-50 hover:text-amber-800 transition-colors"
            >
              Edit
            </.link>
          <% end %>
          <%= if @conn.assigns[:current_user] do %>
            <span class="w-px h-4 bg-gray-200 mx-1"></span>
            <form action="/logout" method="post">
              <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
              <button
                type="submit"
                class="px-3 py-1.5 rounded-md text-sm text-gray-500 hover:bg-gray-100 hover:text-gray-900 transition-colors"
              >
                Sign out
              </button>
            </form>
          <% end %>
        </div>

        <%!-- Mobile hamburger --%>
        <details id="mobile-nav" class="sm:hidden relative">
          <summary class="list-none cursor-pointer p-2 rounded-md hover:bg-gray-100 transition-colors">
            <svg
              class="w-5 h-5 text-gray-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"
              />
            </svg>
          </summary>
          <div class="absolute right-0 top-full mt-1 w-44 bg-white border border-gray-200 rounded-xl shadow-lg py-1 z-50">
            <.link navigate="/" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
              Calendar
            </.link>
            <.link
              navigate="/schedule"
              class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50"
            >
              Schedule
            </.link>
            <.link
              navigate="/compare"
              class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50"
            >
              Compare
            </.link>
            <%= if user = @conn.assigns[:current_user] do %>
              <%= if my_page_path = nav_home_path(user) do %>
                <.link
                  navigate={my_page_path}
                  data-nav-home
                  aria-current={if @conn.request_path == my_page_path, do: "page"}
                  class="block px-4 py-2 text-sm text-green-700 hover:bg-green-50 aria-[current=page]:bg-green-50 aria-[current=page]:font-medium"
                >
                  {nav_home_label(user)}
                </.link>
              <% end %>
            <% end %>
            <%= if ResidencySchedule.Accounts.User.admin?(@conn.assigns[:current_user]) do %>
              <.link
                navigate="/admin"
                class="block px-4 py-2 text-sm text-amber-600 hover:bg-amber-50"
              >
                Admin
              </.link>
              <.link
                navigate="/admin/build"
                class="block px-4 py-2 text-sm text-amber-600 hover:bg-amber-50"
              >
                Build
              </.link>
              <.link
                navigate="/admin/edit"
                class="block px-4 py-2 text-sm text-amber-600 hover:bg-amber-50"
              >
                Edit
              </.link>
            <% end %>
            <%= if @conn.assigns[:current_user] do %>
              <div class="border-t border-gray-100 mt-1 pt-1">
                <form action="/logout" method="post">
                  <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                  <button
                    type="submit"
                    class="block w-full text-left px-4 py-2 text-sm text-gray-500 hover:bg-gray-50"
                  >
                    Sign out
                  </button>
                </form>
              </div>
            <% end %>
          </div>
        </details>
      </div>
    </nav>
    {@inner_content}
  </body>
</html>
