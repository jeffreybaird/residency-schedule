<div class="min-h-screen flex items-center justify-center bg-gray-50 dark:bg-gray-950">
  <div class="max-w-sm w-full bg-white dark:bg-gray-900 rounded-xl shadow-md p-8 text-center">
    <h1 class="text-xl font-semibold text-gray-800 dark:text-gray-100 mb-2">{@title}</h1>
    <p class="text-sm text-gray-600 dark:text-gray-300">{@message}</p>
  </div>
</div>
