[Unit]
Description=Encrypted residency schedule database backup
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
LimitCORE=0
WorkingDirectory=/
ExecStart=/usr/local/bin/ruby /usr/local/lib/residency-schedule-backup/production_backup.rb run /etc/residency-schedule-backup/source.json
TimeoutStartSec=165s
TimeoutStopSec=5s
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/deploy/residency_schedule.deploy.lock
ReadWritePaths=/var/lib/residency-schedule-backup
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_KILL CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_SETUID
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
