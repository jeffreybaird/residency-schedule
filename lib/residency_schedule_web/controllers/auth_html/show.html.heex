<div class="min-h-screen flex items-center justify-center bg-gray-50">
  <div class="max-w-sm w-full bg-white rounded-xl shadow-md p-8">
    <h1 class="text-2xl font-semibold text-gray-800 mb-6 text-center">Residency Schedule</h1>

    <%= if flash = @flash["error"] do %>
      <div class="mb-4 rounded-md bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">
        {flash}
      </div>
    <% end %>

    <%= if flash = @flash["info"] do %>
      <div class="mb-4 rounded-md bg-blue-50 border border-blue-200 px-4 py-3 text-sm text-blue-700">
        {flash}
      </div>
    <% end %>

    <%= case @step do %>
      <% :email -> %>
        <form method="post" action="/login/identify" class="space-y-4">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
              Email address
            </label>
            <input
              type="email"
              id="email"
              name="email"
              autofocus
              placeholder="you@example.com"
              class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>
          <button
            type="submit"
            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-md text-sm transition-colors"
          >
            Continue
          </button>
        </form>

      <% :choose_method -> %>
        <p class="text-sm text-gray-500 text-center mb-4">
          Signing in as <span class="font-medium text-gray-700"><%= @email %></span>
        </p>

        <div class="space-y-3">
          <form method="post" action="/login/send-link">
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <button
              type="submit"
              class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-md text-sm transition-colors"
            >
              Send me a login link
            </button>
          </form>

          <%= if @has_password do %>
            <div class="relative">
              <div class="absolute inset-0 flex items-center">
                <div class="w-full border-t border-gray-200"></div>
              </div>
              <div class="relative flex justify-center text-xs">
                <span class="bg-white px-2 text-gray-400">or</span>
              </div>
            </div>

            <form method="post" action="/login/password" class="space-y-3">
              <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
              <div>
                <label for="password" class="block text-sm font-medium text-gray-700 mb-1">
                  Password
                </label>
                <input
                  type="password"
                  id="password"
                  name="password"
                  autofocus
                  class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
              </div>
              <button
                type="submit"
                class="w-full bg-gray-800 hover:bg-gray-900 text-white font-medium py-2 px-4 rounded-md text-sm transition-colors"
              >
                Log in with password
              </button>
            </form>
          <% end %>
        </div>

        <div class="mt-4 text-center">
          <a href="/login" class="text-sm text-gray-400 hover:text-gray-600">
            ← Use a different email
          </a>
        </div>

      <% :check_email -> %>
        <div class="text-center space-y-3">
          <div class="text-4xl">✉️</div>
          <p class="text-sm text-gray-700">
            We sent a login link to
            <span class="font-medium"><%= @email %></span>
          </p>
          <p class="text-xs text-gray-400">
            Check your inbox and click the link to sign in. It expires in 15 minutes.
          </p>
        </div>

      <% :set_password -> %>
        <p class="text-sm text-gray-500 text-center mb-4">
          You're in! Optionally set a password for faster logins next time.
        </p>

        <form method="post" action="/auth/set-password" class="space-y-4">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <div>
            <label for="password" class="block text-sm font-medium text-gray-700 mb-1">
              Password <span class="text-gray-400 font-normal">(optional)</span>
            </label>
            <input
              type="password"
              id="password"
              name="password"
              autofocus
              placeholder="At least 8 characters"
              class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>
          <button
            type="submit"
            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-md text-sm transition-colors"
          >
            Set password & continue
          </button>
        </form>

        <form method="post" action="/auth/set-password" class="mt-2">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <input type="hidden" name="password" value="" />
          <button
            type="submit"
            class="w-full text-sm text-gray-400 hover:text-gray-600 py-2 transition-colors"
          >
            Skip for now →
          </button>
        </form>

      <% :pending_approval -> %>
        <div class="text-center space-y-3">
          <div class="text-4xl">⏳</div>
          <p class="text-sm text-gray-700">
            Your account (<span class="font-medium"><%= @email %></span>) is pending approval.
          </p>
          <p class="text-xs text-gray-400">
            You'll be able to access the schedule once an administrator approves your account.
          </p>
        </div>
        <div class="mt-4 text-center">
          <a href="/login" class="text-sm text-gray-400 hover:text-gray-600">
            ← Back to login
          </a>
        </div>
    <% end %>
  </div>
</div>
