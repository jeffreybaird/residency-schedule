<!DOCTYPE html>
<html lang="en" class="dark:bg-gray-950">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="brand-name" content={ResidencySchedule.brand_name()} />
    <meta name="demo-mode" content={to_string(ResidencySchedule.demo_mode?())} />
    <.live_title default={ResidencySchedule.brand_name()}>
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        if (window.__residencyThemeInstalled) return;
        window.__residencyThemeInstalled = true;

        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");
        const normalizeTheme = (theme) => ["light", "dark"].includes(theme) ? theme : "system";
        const readPreference = () => {
          try {
            return normalizeTheme(window.localStorage.getItem("phx:theme"));
          } catch (_) {
            return "system";
          }
        };
        let preference = readPreference();

        const syncThemeControls = () => {
          document.querySelectorAll("[data-phx-theme]").forEach(button => {
            button.setAttribute("aria-pressed", String(button.dataset.phxTheme === preference));
          });
        };
        const applyTheme = () => {
          const theme = preference === "system" ? (systemTheme.matches ? "dark" : "light") : preference;
          document.documentElement.setAttribute("data-theme", theme);
          document.documentElement.setAttribute("data-theme-preference", preference);
          syncThemeControls();
        };

        applyTheme();
        window.addEventListener("DOMContentLoaded", syncThemeControls);
        systemTheme.addEventListener("change", () => {
          if (preference === "system") applyTheme();
        });
        window.addEventListener("storage", (event) => {
          if (event.key !== "phx:theme" && event.key !== null) return;
          preference = normalizeTheme(event.key === null ? null : event.newValue);
          applyTheme();
        });

        window.addEventListener("phx:set-theme", (event) => {
          preference = normalizeTheme(event.target.dataset.phxTheme);
          try {
            if (preference === "system") {
              window.localStorage.removeItem("phx:theme");
            } else {
              window.localStorage.setItem("phx:theme", preference);
            }
          } catch (_) {
            // Keep the selected theme usable when browser storage is blocked.
          }
          applyTheme();
        });
      })();
    </script>
  </head>
  <body class="min-h-screen dark:bg-gray-950 dark:text-gray-100">
    <.demo_banner />
    <%!--
      Live navigation replaces only the LiveView below the nav, so nothing in
      this nav re-renders between pages. Anything here that depends on the
      current page (the home link's aria-current, the open mobile menu) is
      kept in step by app.js on phx:navigate.
    --%>
    <nav class="bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700 sticky top-0 z-50">
      <div class="px-4 sm:px-6 py-3 flex items-center justify-between">
        <.link
          navigate="/"
          class="flex items-center gap-2 text-base font-semibold text-gray-800 dark:text-gray-100 hover:text-blue-600 dark:hover:text-blue-300 transition-colors shrink-0"
        >
          <img src="/favicon.svg" alt="" class="w-6 h-6" />{ResidencySchedule.brand_name()}
        </.link>

        <%!-- Desktop nav --%>
        <div id="tour-nav" class="hidden sm:flex items-center gap-1">
          <.link
            navigate="/"
            class="px-3 py-1.5 rounded-md text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-gray-100 transition-colors"
          >
            Calendar
          </.link>
          <.link
            id="tour-nav-schedule"
            navigate="/schedule"
            class="px-3 py-1.5 rounded-md text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-gray-100 transition-colors"
          >
            Schedule
          </.link>
          <.link
            id="tour-nav-compare"
            navigate="/compare"
            class="px-3 py-1.5 rounded-md text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-gray-100 transition-colors"
          >
            Compare
          </.link>
          <.link
            navigate="/activities"
            class="px-3 py-1.5 rounded-md text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-gray-100 transition-colors"
          >
            Activities
          </.link>
          <%= if user = @conn.assigns[:current_user] do %>
            <%= if my_page_path = nav_home_path(user) do %>
              <.link
                navigate={my_page_path}
                data-nav-home
                aria-current={if @conn.request_path == my_page_path, do: "page"}
                class="px-3 py-1.5 rounded-md text-sm text-green-700 dark:text-green-300 hover:bg-green-50 dark:hover:bg-green-950 transition-colors aria-[current=page]:bg-green-50 dark:aria-[current=page]:bg-green-950 aria-[current=page]:font-medium"
              >
                {nav_home_label(user)}
              </.link>
            <% end %>
          <% end %>
          <%= if ResidencySchedule.Accounts.User.admin?(@conn.assigns[:current_user]) do %>
            <.link
              navigate="/admin"
              class="px-3 py-1.5 rounded-md text-sm text-amber-600 dark:text-amber-300 hover:bg-amber-50 dark:hover:bg-amber-950 hover:text-amber-800 dark:hover:text-amber-300 transition-colors"
            >
              Admin
            </.link>
            <.link
              navigate="/admin/build"
              class="px-3 py-1.5 rounded-md text-sm text-amber-600 dark:text-amber-300 hover:bg-amber-50 dark:hover:bg-amber-950 hover:text-amber-800 dark:hover:text-amber-300 transition-colors"
            >
              Build
            </.link>
            <.link
              navigate="/admin/edit"
              class="px-3 py-1.5 rounded-md text-sm text-amber-600 dark:text-amber-300 hover:bg-amber-50 dark:hover:bg-amber-950 hover:text-amber-800 dark:hover:text-amber-300 transition-colors"
            >
              Edit
            </.link>
          <% end %>
          <%= if @conn.assigns[:current_user] do %>
            <span class="w-px h-4 bg-gray-200 dark:bg-gray-700 mx-1"></span>
            <form action="/logout" method="post">
              <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
              <button
                type="submit"
                class="px-3 py-1.5 rounded-md text-sm text-gray-500 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-gray-100 transition-colors"
              >
                Sign out
              </button>
            </form>
          <% end %>
        </div>

        <.theme_toggle />

        <%!-- Mobile hamburger --%>
        <details id="mobile-nav" class="sm:hidden relative">
          <summary class="list-none cursor-pointer p-2 rounded-md hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
            <svg
              class="w-5 h-5 text-gray-600 dark:text-gray-300"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"
              />
            </svg>
          </summary>
          <div class="absolute right-0 top-full mt-1 w-44 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl shadow-lg py-1 z-50">
            <.link
              navigate="/"
              class="block px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-950"
            >
              Calendar
            </.link>
            <.link
              navigate="/schedule"
              class="block px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-950"
            >
              Schedule
            </.link>
            <.link
              navigate="/compare"
              class="block px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-950"
            >
              Compare
            </.link>
            <.link
              navigate="/activities"
              class="block px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-950"
            >
              Activities
            </.link>
            <%= if user = @conn.assigns[:current_user] do %>
              <%= if my_page_path = nav_home_path(user) do %>
                <.link
                  navigate={my_page_path}
                  data-nav-home
                  aria-current={if @conn.request_path == my_page_path, do: "page"}
                  class="block px-4 py-2 text-sm text-green-700 dark:text-green-300 hover:bg-green-50 dark:hover:bg-green-950 aria-[current=page]:bg-green-50 dark:aria-[current=page]:bg-green-950 aria-[current=page]:font-medium"
                >
                  {nav_home_label(user)}
                </.link>
              <% end %>
            <% end %>
            <%= if ResidencySchedule.Accounts.User.admin?(@conn.assigns[:current_user]) do %>
              <.link
                navigate="/admin"
                class="block px-4 py-2 text-sm text-amber-600 dark:text-amber-300 hover:bg-amber-50 dark:hover:bg-amber-950"
              >
                Admin
              </.link>
              <.link
                navigate="/admin/build"
                class="block px-4 py-2 text-sm text-amber-600 dark:text-amber-300 hover:bg-amber-50 dark:hover:bg-amber-950"
              >
                Build
              </.link>
              <.link
                navigate="/admin/edit"
                class="block px-4 py-2 text-sm text-amber-600 dark:text-amber-300 hover:bg-amber-50 dark:hover:bg-amber-950"
              >
                Edit
              </.link>
            <% end %>
            <%= if @conn.assigns[:current_user] do %>
              <div class="border-t border-gray-100 dark:border-gray-700 mt-1 pt-1">
                <form action="/logout" method="post">
                  <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                  <button
                    type="submit"
                    class="block w-full text-left px-4 py-2 text-sm text-gray-500 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-950"
                  >
                    Sign out
                  </button>
                </form>
              </div>
            <% end %>
          </div>
        </details>
      </div>
    </nav>
    {@inner_content}
  </body>
</html>
