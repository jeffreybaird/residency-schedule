<div class="min-h-screen flex items-center justify-center bg-gray-50 dark:bg-gray-950">
  <div class="max-w-sm w-full bg-white dark:bg-gray-900 rounded-xl shadow-md p-8">
    <h1 class="text-2xl font-semibold text-gray-800 dark:text-gray-100 mb-6 text-center">
      Residency Schedule
    </h1>

    <%= if flash = @flash["error"] do %>
      <div class="mb-4 rounded-md bg-red-50 dark:bg-red-950 border border-red-200 dark:border-red-800 px-4 py-3 text-sm text-red-700 dark:text-red-300">
        {flash}
      </div>
    <% end %>

    <%= if flash = @flash["info"] do %>
      <div class="mb-4 rounded-md bg-blue-50 dark:bg-blue-950 border border-blue-200 dark:border-blue-800 px-4 py-3 text-sm text-blue-700 dark:text-blue-300">
        {flash}
      </div>
    <% end %>

    <%= case @step do %>
      <% :email -> %>
        <form method="post" action="/login/identify" class="space-y-4">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <div>
            <label
              for="email"
              class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1"
            >
              Email address
            </label>
            <input
              type="email"
              id="email"
              name="email"
              autofocus
              placeholder="you@example.com"
              class="w-full border border-gray-300 dark:border-gray-600 rounded-md px-3 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>
          <button
            type="submit"
            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-md text-sm transition-colors"
          >
            Continue
          </button>
        </form>
      <% :choose_method -> %>
        <p class="text-sm text-gray-500 dark:text-gray-300 text-center mb-4">
          Signing in as <span class="font-medium text-gray-700 dark:text-gray-200">{@email}</span>
        </p>

        <div class="space-y-3">
          <form method="post" action="/login/send-link">
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <button
              type="submit"
              class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-md text-sm transition-colors"
            >
              Send me a login link
            </button>
          </form>

          <%= if @has_password do %>
            <div class="relative">
              <div class="absolute inset-0 flex items-center">
                <div class="w-full border-t border-gray-200 dark:border-gray-700"></div>
              </div>
              <div class="relative flex justify-center text-xs">
                <span class="bg-white dark:bg-gray-900 px-2 text-gray-400 dark:text-gray-400">
                  or
                </span>
              </div>
            </div>

            <form method="post" action="/login/password" class="space-y-3">
              <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
              <div>
                <label
                  for="password"
                  class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1"
                >
                  Password
                </label>
                <input
                  type="password"
                  id="password"
                  name="password"
                  autofocus
                  class="w-full border border-gray-300 dark:border-gray-600 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
              </div>
              <button
                type="submit"
                class="w-full bg-gray-800 hover:bg-gray-900 text-white font-medium py-2 px-4 rounded-md text-sm transition-colors"
              >
                Log in with password
              </button>
            </form>
          <% end %>
        </div>

        <div class="mt-4 text-center">
          <a
            href="/login"
            class="text-sm text-gray-400 dark:text-gray-400 hover:text-gray-600 dark:hover:text-gray-300"
          >
            ← Use a different email
          </a>
        </div>
      <% :check_email -> %>
        <div class="text-center space-y-3">
          <div class="text-4xl">✉️</div>
          <p class="text-sm text-gray-700 dark:text-gray-200">
            We sent a login link to <span class="font-medium">{@email}</span>
          </p>
          <p class="text-xs text-gray-400 dark:text-gray-400">
            Check your inbox and click the link to sign in. It expires in 15 minutes.
          </p>
        </div>
      <% :confirm_login -> %>
        <div class="text-center space-y-4">
          <p class="text-sm text-gray-700 dark:text-gray-200">
            Click below to finish signing in as <span class="font-medium">{@email}</span>.
          </p>
          <form method="post" action="/auth/verify">
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <input type="hidden" name="token" value={@token} />
            <button
              type="submit"
              class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-md text-sm transition-colors"
            >
              Sign in
            </button>
          </form>
        </div>
      <% :set_password -> %>
        <p class="text-sm text-gray-500 dark:text-gray-300 text-center mb-4">
          You're in! Optionally set a password for faster logins next time.
        </p>

        <form method="post" action="/auth/set-password" class="space-y-4">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <div>
            <label
              for="password"
              class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1"
            >
              Password
              <span class="text-gray-400 dark:text-gray-400 font-normal">(optional)</span>
            </label>
            <input
              type="password"
              id="password"
              name="password"
              autofocus
              placeholder="At least 8 characters"
              class="w-full border border-gray-300 dark:border-gray-600 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>
          <button
            type="submit"
            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-md text-sm transition-colors"
          >
            Set password & continue
          </button>
        </form>

        <form method="post" action="/auth/set-password" class="mt-2">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <input type="hidden" name="password" value="" />
          <button
            type="submit"
            class="w-full text-sm text-gray-400 dark:text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 py-2 transition-colors"
          >
            Skip for now →
          </button>
        </form>
      <% :pending_approval -> %>
        <div class="text-center space-y-3">
          <div class="text-4xl">⏳</div>
          <p class="text-sm text-gray-700 dark:text-gray-200">
            Your account (<span class="font-medium"><%= @email %></span>) is pending approval.
          </p>
          <p class="text-xs text-gray-400 dark:text-gray-400">
            You'll be able to access the schedule once an administrator approves your account.
          </p>
        </div>
        <div class="mt-4 text-center">
          <a
            href="/login"
            class="text-sm text-gray-400 dark:text-gray-400 hover:text-gray-600 dark:hover:text-gray-300"
          >
            ← Back to login
          </a>
        </div>
      <% :denied -> %>
        <div class="text-center space-y-3">
          <div class="text-4xl">🚫</div>
          <p class="text-sm text-gray-700 dark:text-gray-200">
            Your access request for <span class="font-medium">{@email}</span> was not approved.
          </p>
          <p class="text-xs text-gray-400 dark:text-gray-400">
            If you believe this was a mistake, reply to the email we sent you and an
            administrator can take another look.
          </p>
        </div>
        <div class="mt-4 text-center">
          <a
            href="/login"
            class="text-sm text-gray-400 dark:text-gray-400 hover:text-gray-600 dark:hover:text-gray-300"
          >
            ← Back to login
          </a>
        </div>
    <% end %>
  </div>
</div>
