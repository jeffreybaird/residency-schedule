<div class="min-h-screen flex items-center justify-center bg-gray-50 dark:bg-gray-950">
  <div class="max-w-md w-full bg-white dark:bg-gray-900 rounded-xl shadow-md p-8">
    <h1 class="text-2xl font-semibold text-gray-800 dark:text-gray-100 mb-2 text-center">
      Connect an assistant
    </h1>
    <p class="text-sm text-gray-600 dark:text-gray-300 mb-6 text-center">
      <span class="font-medium text-gray-800 dark:text-gray-100">
        {@client.client_name || "An application"}
      </span>
      wants to access the residency schedule as <span class="font-medium text-gray-800 dark:text-gray-100">{@user.email}</span>.
    </p>

    <ul class="text-sm text-gray-700 dark:text-gray-200 mb-6 space-y-1 list-disc list-inside">
      <li>Read the schedule, who is on service, and shared shifts</li>
      <li>File schedule change requests on your behalf (pending admin approval)</li>
      <li :if={@user.role == :admin}>Approve or deny change requests</li>
    </ul>

    <form method="post" action="/oauth/authorize" class="space-y-3">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <input :for={{key, value} <- @request} type="hidden" name={key} value={value} />
      <button
        type="submit"
        name="decision"
        value="approve"
        class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-md text-sm transition-colors"
      >
        Allow access
      </button>
      <button
        type="submit"
        name="decision"
        value="deny"
        class="w-full bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-800 dark:text-gray-100 font-medium py-2 px-4 rounded-md text-sm transition-colors"
      >
        Deny
      </button>
    </form>
  </div>
</div>
